---
// Story Variant Page - Programmatic SEO for seasonal/themed story variants
import BaseLayout from '../../../layouts/BaseLayout.astro'
import StoryGameWithShare from '../../../components/ai/StoryGameWithShare'
import { getAllStoryVariants, getStoryVariant, getVariantsForStory } from '../../../data/storyVariants'
import { getStoryGenreForTemplateType } from '../../../data/storyGenres'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const variants = getAllStoryVariants()
  return variants.map(variant => ({
    params: { slug: variant.storySlug, variant: variant.variant },
    props: { variant },
  }))
}

const { slug, variant: variantName } = Astro.params
if (!slug || !variantName) {
  return Astro.redirect('/404')
}

const variant = getStoryVariant(slug, variantName)

if (!variant) {
  return Astro.redirect('/404')
}

// Load the base story template
const stories = await getCollection('stories')
const storyEntry = stories.find(s => s.data.slug === slug)
if (!storyEntry) {
  return Astro.redirect('/404')
}

const story = storyEntry.data
const storyName = variant.h1 || story.en.name
const storyIcon = story.icon

const seoTitle = `${variant.title} | Free Games Hub`
const seoDescription = variant.description
const canonicalUrl = `https://ruleword.com/stories/${slug}/${variantName}/`
const baseStoryUrl = `https://ruleword.com/stories/${story.slug}/`
const storyGenre = getStoryGenreForTemplateType(story.templateType)
const variantLabel = variant.variant.charAt(0).toUpperCase() + variant.variant.slice(1).replace(/-/g, ' ')
const variantIntent = variant.variantType === 'seasonal'
  ? {
      label: 'Seasonal Edition',
      summary: `${variant.h1} adds a timely setting and special choices to ${story.en.name}, making the story feel different from the original route.`,
      focus: 'Play this edition when you want a familiar AI story with a stronger seasonal hook and fresh replay goals.',
    }
  : {
      label: 'Themed Edition',
      summary: `${variant.h1} reshapes ${story.en.name} around a focused theme, giving the same core story loop a more specific setting and mood.`,
      focus: 'Play this edition when you want a sharper scenario, different roleplay cues, and a new reason to replay.',
    }

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'AI Stories', url: '/stories/' },
  { name: story.en.name, url: `/stories/${story.slug}/` },
  { name: variantLabel, url: `/stories/${slug}/${variantName}/` },
]

const schema = {
  "@context": "https://schema.org",
  "@type": ["Game", "WebApplication"],
  "name": variant.title,
  "description": variant.description,
  "alternateName": variant.h1,
  "genre": "Interactive Fiction",
  "gamePlatform": "Web Browser",
  "applicationCategory": "GameApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript and a modern web browser",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "url": canonicalUrl,
  "isBasedOn": {
    "@type": "Game",
    "name": story.en.name,
    "url": baseStoryUrl,
  },
  "keywords": variant.keywords,
  "numberOfPlayers": 1,
  "playMode": "SinglePlayer",
  "potentialAction": {
    "@type": "PlayAction",
    "target": canonicalUrl,
  },
}

// Other variants for the same story
const otherVariants = getVariantsForStory(slug).filter(v => v.variant !== variantName)
const relatedLinks = [
  { href: `/stories/${story.slug}/`, label: `Play ${story.en.name}`, description: 'Return to the original story and compare the default route.' },
  { href: `/stories/genre/${storyGenre.slug}/`, label: storyGenre.label, description: 'Browse more AI stories with a similar mood, genre, or choice structure.' },
  { href: '/stories/', label: 'All AI Stories', description: 'Explore the full library of romance, mystery, survival, fantasy, and simulation stories.' },
]
const relatedLinksSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Related pages for ${variant.title}`,
  "itemListElement": relatedLinks.map((link, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": link.label,
    "url": `https://ruleword.com${link.href}`,
  }))
}
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={variant.keywords.join(', ')}
  canonicalPath={`/stories/${slug}/${variantName}/`}
  ogImage={`/og/story-${slug}.png`}
  breadcrumbItems={breadcrumbItems}
>
  <div class="min-h-screen bg-slate-950 text-white flex flex-col">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-slate-950/90 border-b border-slate-800 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <div class="flex items-center gap-4">
            <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center text-white font-bold text-sm shadow-lg">R</div>
              <span class="font-semibold hidden sm:inline">Free Games Hub</span>
            </a>
          </div>
          <h1 class="text-lg font-bold truncate max-w-[200px] sm:max-w-none">{storyIcon} {variant.title.split(' - ')[0]}</h1>
          <div class="flex items-center gap-2">
            <a href={`/stories/${slug}/`} class="text-sm text-pink-400 hover:text-pink-300 transition-colors">Original Version</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Variant Banner -->
    <div class="bg-gradient-to-r from-purple-900/30 to-pink-900/30 border-b border-purple-800/50 py-3 px-4 text-center">
      <span class="text-purple-300 text-sm">
        ✨ {variant.variantType === 'seasonal' ? 'Seasonal Special' : 'Themed Edition'}:
        {variant.subtitle || variant.h1}
      </span>
    </div>

    <!-- Game Area -->
    <main class="h-[calc(100vh-7rem)] relative">
      <StoryGameWithShare
        client:load
        template={JSON.stringify(story)}
        gameName={storyName}
        gameSlug={story.slug}
        gameEmoji={storyIcon}
      />
    </main>

    <!-- SEO Content Section -->
    <section class="bg-slate-900/50 border-t border-slate-800 py-12 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold mb-6">{variant.title}</h2>

        <div class="prose prose-invert max-w-none space-y-8">
          <!-- Description -->
          <div>
            <p class="text-slate-300 text-lg leading-relaxed">{variant.description}</p>
          </div>

          <!-- Tips -->
          {variant.tips && variant.tips.length > 0 && (
            <div>
              <h3 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
                <span class="text-2xl">💡</span> Tips for This Edition
              </h3>
              <ul class="space-y-2">
                {variant.tips.map(tip => (
                  <li class="flex gap-2 text-slate-300">
                    <span class="text-pink-400 shrink-0">•</span>
                    <span class="text-sm">{tip}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
            <div class="rounded-xl border border-slate-700/60 bg-slate-800/40 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink-300">{variantIntent.label}</p>
              <h3 class="mt-2 text-xl font-semibold text-white">Why Play {variant.h1}?</h3>
              <p class="mt-3 text-sm leading-6 text-slate-300">{variantIntent.summary}</p>
              <p class="mt-3 text-sm leading-6 text-slate-400">{variantIntent.focus}</p>
            </div>
            <div class="rounded-xl border border-slate-700/60 bg-slate-800/40 p-5">
              <h3 class="text-xl font-semibold text-white">Best For</h3>
              <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-300">
                <li class="flex gap-3">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-pink-400"></span>
                  Players searching for {variant.keywords[0] || variant.h1.toLowerCase()}.
                </li>
                <li class="flex gap-3">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-pink-400"></span>
                  Replay sessions where new choices and endings matter.
                </li>
                <li class="flex gap-3">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-pink-400"></span>
                  Fans of {storyGenre.label.toLowerCase()} stories.
                </li>
              </ul>
            </div>
          </div>

          <!-- Other Variants -->
          {otherVariants.length > 0 && (
            <div>
              <h3 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
                <span class="text-2xl">🎮</span> More Editions
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {otherVariants.map(v => (
                  <a
                    href={`/stories/${slug}/${v.variant}/`}
                    class="block bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 hover:border-pink-500/50 transition-colors"
                  >
                    <h4 class="text-white font-semibold text-sm">{v.h1}</h4>
                    <p class="text-slate-400 text-xs mt-1 line-clamp-2">{v.description}</p>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div>
            <h3 class="text-xl font-semibold text-white mb-4">Continue Exploring</h3>
            <div class="grid gap-3 md:grid-cols-3">
              {relatedLinks.map(link => (
                <a
                  href={link.href}
                  class="block rounded-xl border border-pink-800/40 bg-gradient-to-br from-pink-950/30 to-slate-800/60 p-4 transition-colors hover:border-pink-500/60"
                >
                  <h4 class="text-sm font-semibold text-white">{link.label}</h4>
                  <p class="mt-2 text-xs leading-5 text-slate-400">{link.description}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(relatedLinksSchema)} />

    <script>
      // Back navigation for AIStoryGame component
      window.addEventListener('message', (e) => {
        if (e.data?.type === 'navigate-back') {
          window.location.href = '/stories/'
        }
      })
    </script>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-4 px-4 text-center text-sm text-slate-500">
      © 2026 Free Games Hub — Play Free Online Games
    </footer>
  </div>
</BaseLayout>
