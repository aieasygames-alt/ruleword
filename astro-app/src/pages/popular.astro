---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getAllGames } from '../lib/games'
import { getGamePopularity, THUMBNAIL_GAMES } from '../data/gamePopularity'
import { opportunityGameSlugs } from '../data/siteGrowth'

const games = await getAllGames()
const sortedGames = games
  .slice()
  .sort((a, b) => getGamePopularity(b.slug).numericCount - getGamePopularity(a.slug).numericCount)

const opportunityGames = opportunityGameSlugs
  .map(slug => games.find(game => game.slug === slug))
  .filter(Boolean)

const popularGroups = [
  {
    title: 'Search Opportunity Picks',
    description: 'Pages worth strengthening because they combine clear player intent with strong internal-link potential.',
    games: opportunityGames,
  },
  {
    title: 'Most Played Classics',
    description: 'Evergreen games with broad audience demand and strong repeat-play value.',
    games: sortedGames.slice(0, 12),
  },
  {
    title: 'Brain Test Favorites',
    description: 'Fast tests that work well for shareable results, repeat attempts, and guide content.',
    games: sortedGames.filter(game => ['skill', 'memory'].includes(game.category)).slice(0, 8),
  },
]

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Popular Free Online Games',
  itemListElement: sortedGames.slice(0, 20).map((game, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: game.name,
    url: `https://ruleword.com/games/${game.slug}/`,
  })),
}
---

<BaseLayout
  title="Popular Free Online Games - Boggle, Sudoku, 2048 & Brain Tests"
  description="Play the most popular free online games on Ruleword: Boggle, Sudoku, 2048, reaction time test, typing test, chess, checkers, Wordle, Tetris, and more."
  keywords="popular online games, most played browser games, boggle online, sudoku online, 2048 game, reaction time test, typing test"
  canonicalPath="/popular/"
  ogImage="/og/home.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <div class="min-h-screen bg-slate-950 text-white">
    <header class="border-b border-slate-800 bg-slate-950/90">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 hover:opacity-80">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-green-400 to-emerald-600 text-sm font-bold">R</div>
          <span class="font-semibold">Free Games Hub</span>
        </a>
        <nav class="flex items-center gap-4 text-sm text-slate-400">
          <a href="/games/" class="hover:text-white">All Games</a>
          <a href="/new/" class="hover:text-white">New</a>
          <a href="/guides/" class="hover:text-white">Guides</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
      <section class="rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950/50 p-6 sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-400">Popular Games</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">Most Played Free Online Games</h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
          Start with the games that deserve the most product and SEO attention: quick-play classics, brain tests, word games, number puzzles, and strategy games with repeatable sessions.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/games/boggle/" class="rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-emerald-500">Play Boggle</a>
          <a href="/games/reaction-time/" class="rounded-xl border border-slate-700 bg-slate-900 px-5 py-2.5 text-sm font-medium text-slate-200 hover:bg-slate-800">Test Reaction Time</a>
          <a href="/games/typing-test/" class="rounded-xl border border-slate-700 bg-slate-900 px-5 py-2.5 text-sm font-medium text-slate-200 hover:bg-slate-800">Typing Test</a>
        </div>
      </section>

      <div class="mt-10 space-y-10">
        {popularGroups.map(group => (
          <section>
            <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h2 class="text-2xl font-bold">{group.title}</h2>
                <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-400">{group.description}</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {group.games.map((game, index) => {
                const popularity = getGamePopularity(game.slug)
                return (
                  <a href={`/games/${game.slug}/`} class="group overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 transition-all hover:-translate-y-0.5 hover:border-emerald-700">
                    <div class="relative aspect-[4/3] bg-slate-950">
                      {THUMBNAIL_GAMES.has(game.slug) ? (
                        <img src={`/thumbnails/${game.slug}.png`} alt={game.name} class="h-full w-full object-cover opacity-70 transition-opacity group-hover:opacity-90" loading="lazy" />
                      ) : (
                        <div class={`flex h-full w-full items-center justify-center bg-gradient-to-br ${game.color} text-5xl`}>{game.icon}</div>
                      )}
                      <span class="absolute left-3 top-3 rounded-full bg-black/45 px-2.5 py-1 text-xs font-semibold">#{index + 1}</span>
                    </div>
                    <div class="p-4">
                      <div class="flex items-start justify-between gap-3">
                        <h3 class="font-semibold text-white group-hover:text-emerald-300">{game.name}</h3>
                        <span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-1 text-[11px] text-emerald-300">{popularity.playCount}</span>
                      </div>
                      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-400">{game.desc}</p>
                    </div>
                  </a>
                )
              })}
            </div>
          </section>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
