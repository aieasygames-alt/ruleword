---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GameWrapper from '../../components/GameWrapper'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getAllGames, getAllGameSlugs, getGameBySlug, type GameData as CMSGameData } from '../../lib/games'
import { categories } from '../../data/categories'
import { i18n, categoryI18n, type Language, languages } from '../../data/i18n'
import { getGameSEO, generateKeywords } from '../../data/seo'
import { getGameGuide, getAllGuideSlugs } from '../../data/gameGuidesSEO'
import { hubPages } from '../../data/hubPages'
import { getGameRating } from '../../data/gameRatings'
import { getGamePopularity } from '../../data/gamePopularity'
import FavoriteButton from '../../components/FavoriteButton'
import type { GameRules, GameFAQ } from '../../types'

// 在 getStaticPaths 中获取所有游戏
export async function getStaticPaths() {
  // 数据源选择：优先使用 CMS（Sanity），回退到本地 JSON
  const useCMS = !!import.meta.env.SANITY_PROJECT_ID

  const slugs = await getAllGameSlugs()
  const allCMSGames = useCMS ? await getAllGames() : null

  // 如果使用 CMS，从 CMS 获取数据
  if (useCMS && allCMSGames) {
    return slugs.map(slug => ({
      params: { slug },
      props: {
        game: allCMSGames.find(g => g.slug === slug),
        allGames: allCMSGames,
        useCMS: true
      }
    }))
  }

  // 回退到本地 JSON
  const gamesCollection = await getCollection('games')
  const allGames = gamesCollection.map(entry => entry.data)

  return gamesCollection.map(entry => ({
    params: { slug: entry.data.slug },
    props: { game: entry.data, allGames, useCMS: false }
  }))
}

// 兼容本地 JSON 格式
interface LocalGameData {
  id: string
  slug: string
  icon: string
  category: 'word' | 'logic' | 'strategy' | 'arcade' | 'memory' | 'skill' | 'puzzle'
  featured?: boolean
  color: string
  en: {
    name: string
    desc: string
    description?: string
    objectives?: string
    howToPlay?: string
    rules?: GameRules
    tips?: string[]
    faq?: GameFAQ[]
  }
  zh?: {
    name: string
    desc: string
    description?: string
    objectives?: string
    howToPlay?: string
    rules?: GameRules
    tips?: string[]
    faq?: GameFAQ[]
  }
}

type GameData = LocalGameData | CMSGameData

const { game, allGames: gamesList, useCMS } = Astro.props as {
  game: GameData
  allGames: GameData[]
  useCMS: boolean
}

// Get language from URL parameter, default to 'en'
const urlLang = Astro.url.searchParams.get('lang') as string
const lang: Language = languages.some(l => l.code === urlLang) ? (urlLang as Language) : 'en'
const t = i18n[lang]

// Helper to get game field (兼容 CMS 和本地格式)
const getGameField = (field: 'name' | 'desc' | 'description' | 'objectives' | 'howToPlay' | 'tips' | 'rules' | 'faq', preferLang: 'en' | 'zh' = 'en'): string | string[] | GameRules | GameFAQ[] => {
  // 统一使用 GameData 格式 (games.ts 已经合并了本地和 CMS 数据)
  const g = game as CMSGameData

  if (field === 'name') return preferLang === 'zh' ? (g.nameZh || g.name) : g.name
  if (field === 'desc') return preferLang === 'zh' ? (g.descZh || g.desc) : g.desc
  if (field === 'description') {
    const zhDesc = g.descriptionZh || g.descZh || g.desc || ''
    const enDesc = g.description || g.desc || ''
    return preferLang === 'zh' ? (zhDesc || enDesc) : enDesc
  }
  if (field === 'objectives') {
    const zhObj = g.objectivesZh || g.objectives || ''
    const enObj = g.objectives || ''
    return preferLang === 'zh' ? (zhObj || enObj) : enObj
  }
  if (field === 'howToPlay') return preferLang === 'zh' ? (g.howToPlayZh || g.howToPlay || '') : (g.howToPlay || '')
  if (field === 'tips') return preferLang === 'zh' ? (g.tipsZh || g.tips || []) : (g.tips || [])
  if (field === 'rules') return preferLang === 'zh' ? (g.rulesZh || g.rules || {}) : (g.rules || {})
  if (field === 'faq') return preferLang === 'zh' ? (g.faqZh || g.faq || []) : (g.faq || [])
  return ''
}

// Get game guide content
const gameGuideEn = {
  intro: getGameField('desc', 'en') as string,
  description: getGameField('description', 'en') as string,
  objectives: getGameField('objectives', 'en') as string,
  howToPlay: getGameField('howToPlay', 'en') as string,
  rules: getGameField('rules', 'en') as GameRules,
  tips: getGameField('tips', 'en') as string[],
  faq: getGameField('faq', 'en') as GameFAQ[]
}
const gameGuideZhCN = {
  intro: getGameField('desc', 'zh') as string,
  description: getGameField('description', 'zh') as string,
  objectives: getGameField('objectives', 'zh') as string,
  howToPlay: getGameField('howToPlay', 'zh') as string,
  rules: getGameField('rules', 'zh') as GameRules,
  tips: getGameField('tips', 'zh') as string[],
  faq: getGameField('faq', 'zh') as GameFAQ[]
}

// For SEO, use English as default
const gameGuide = gameGuideEn

// Get category for gameType with i18n
const category = categories.find(c => c.id === game.category)
const categoryData = categoryI18n[lang]?.[game.category]
const gameType = categoryData?.name || category?.name || 'Puzzle'

// Get game name for SEO
const gameNameEn = getGameField('name', 'en') as string
const gameNameZh = getGameField('name', 'zh') as string

// Get SEO config for this game
const gameSEO = getGameSEO(game.slug)

// Build optimized keywords from SEO config
const keywords = generateKeywords(gameSEO)

// Helper for localized game name
const getGameName = () => getGameField('name', lang === 'zh-CN' ? 'zh' : 'en') as string
const getGameDesc = () => getGameField('desc', lang === 'zh-CN' ? 'zh' : 'en') as string

// Get game ID (compatible with both formats)
const gameId = useCMS ? (game as CMSGameData).id : (game as LocalGameData).id
const gameSlug = game.slug
const gameIcon = game.icon

// Check if external game
const isExternalGame = useCMS && (game as CMSGameData).isExternal
const externalGameData = isExternalGame ? (game as CMSGameData) : null

// Feedback i18n data
const f = t.feedback

// Find which hubs this game belongs to
const gameHubs = Object.values(hubPages).filter(hub =>
  hub.featuredGames.includes(gameSlug)
)

const relatedPriorityByCategory: Record<string, string[]> = {
  word: ['boggle', 'crosswordle', 'wordle', 'connections', 'spelling-bee', 'word-search'],
  logic: ['heyawake', 'suguru', 'skyscrapers', 'slitherlink', 'kakurasu', '2048', 'nonogram', 'sudoku']
}
const relatedPriority = relatedPriorityByCategory[game.category] || []
const relatedGames = gamesList
  .filter(g => g.category === game.category && g.slug !== gameSlug)
  .sort((a, b) => {
    const priorityA = relatedPriority.indexOf(a.slug)
    const priorityB = relatedPriority.indexOf(b.slug)
    return (priorityA === -1 ? 999 : priorityA) - (priorityB === -1 ? 999 : priorityB)
  })
  .slice(0, 4)

// Breadcrumb for structured data
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: categoryData?.name || category?.name || 'Games', url: `/category/${game.category}/` },
  { name: gameNameEn, url: `/games/${game.slug}/` }
]

// Optimized SEO title and description
const defaultSeoTitle = gameSEO.titleTemplate
  .replace('{game}', gameNameEn)
  .replace('{brand}', 'Free Games Hub')

const defaultSeoDescription = gameSEO.descriptionTemplate
  .replace('{game}', gameNameEn)
  .replace('{brand}', 'Free Games Hub')
const seoTitle = gameSlug === 'boggle'
  ? 'Play Boggle Online Free - 4x4, 5x5 & Daily Word Game | Free Games Hub'
  : defaultSeoTitle
const seoDescription = gameSlug === 'boggle'
  ? 'Play Boggle online free with classic 4x4, big 5x5, daily challenge, relaxed practice, hints, scoring review, and missed-word recap. No download or sign-up.'
  : defaultSeoDescription

// Handle lang parameter for SEO
const hasLangParam = Astro.url.searchParams.has('lang')
const currentLangParam = Astro.url.searchParams.get('lang')
const canonicalUrl = `https://ruleword.com/games/${game.slug}/`

// Generate HowTo Schema for games with howToPlay content
const howToSchema = gameGuideEn.howToPlay ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Play ${gameNameEn}`,
  "description": gameGuideEn.description || gameGuideEn.intro,
  "step": [
    {
      "@type": "HowToStep",
      "name": "Open the Game",
      "text": `Navigate to ${gameNameEn} on Free Games Hub and wait for the game to load.`,
      "url": canonicalUrl
    },
    ...(gameGuideEn.rules?.mechanics?.slice(0, 4).map((mechanic, i) => ({
      "@type": "HowToStep",
      "name": `Step ${i + 2}`,
      "text": mechanic,
      "url": canonicalUrl
    })) || [])
  ],
  "totalTime": "PT5M",
  "tool": {
    "@type": "HowToTool",
    "name": "Web Browser"
  }
} : undefined

const gameRating = getGameRating(game.slug)
const gamePopularity = getGamePopularity(game.slug)
const isBogglePage = gameSlug === 'boggle'
const boggleQuickFacts = [
  { labelEn: 'Grid', labelZh: '棋盘', valueEn: 'Classic 4x4 and big 5x5 boards', valueZh: '经典 4x4 与大型 5x5 棋盘' },
  { labelEn: 'Modes', labelZh: '模式', valueEn: 'Classic, relaxed, and daily challenge', valueZh: '经典、放松与每日挑战' },
  { labelEn: 'Mode', labelZh: '模式', valueEn: 'Unlimited browser play', valueZh: '浏览器无限畅玩' },
  { labelEn: 'Skills', labelZh: '锻炼', valueEn: 'Vocabulary, speed, pattern recognition', valueZh: '词汇、速度、模式识别' }
]
const boggleRuleHighlights = [
  { en: 'Connect letters horizontally, vertically, or diagonally to build words.', zh: '通过横向、纵向或对角线连接字母来组成单词。' },
  { en: 'Every word must be at least 3 letters long.', zh: '每个单词至少要有 3 个字母。' },
  { en: 'You can only use each tile once in a single word path.', zh: '同一个单词路径里，每个字母格只能使用一次。' },
  { en: 'Longer words score more points, so extend short finds whenever possible.', zh: '更长的单词分数更高，所以尽量把短词继续延展。' }
]
const boggleRulesSummary = [
  { ruleEn: 'Board format', ruleZh: '棋盘形式', detailEn: 'Classic Boggle uses a 4x4 grid, while Big Boggle-style play uses a 5x5 grid.', detailZh: '经典 Boggle 使用 4x4 网格，大型 Boggle 风格玩法使用 5x5 网格。' },
  { ruleEn: 'Valid paths', ruleZh: '有效路径', detailEn: 'Letters can connect horizontally, vertically, or diagonally.', detailZh: '字母可以横向、纵向或对角线连接。' },
  { ruleEn: 'Minimum word', ruleZh: '最短词长', detailEn: 'Words must be at least 3 letters long in classic play.', detailZh: '在经典玩法中，单词至少要有 3 个字母。' },
  { ruleEn: 'Tile reuse', ruleZh: '重复使用', detailEn: 'A tile can only be used once in a single word.', detailZh: '同一个单词里，每个字母格只能使用一次。' },
  { ruleEn: 'Dictionary rule', ruleZh: '字典规则', detailEn: 'Proper nouns, abbreviations, and most non-standard words are not allowed.', detailZh: '专有名词、缩写和大多数非标准词通常不算有效。' },
  { ruleEn: 'Qu tile', ruleZh: 'Qu 方块', detailEn: 'The Qu tile counts as both letters together and often unlocks longer words.', detailZh: 'Qu 方块会同时算作 Q 和 U，经常能帮助你拼出更长单词。' }
]
const boggleScoringTable = [
  { lengthEn: '3-4 letters', lengthZh: '3-4 个字母', pointsEn: '1 point', pointsZh: '1 分', noteEn: 'Useful for cleanup and quick board coverage.', noteZh: '适合最后扫尾和快速覆盖棋盘。' },
  { lengthEn: '5 letters', lengthZh: '5 个字母', pointsEn: '2 points', pointsZh: '2 分', noteEn: 'A solid middle tier when you can extend short stems.', noteZh: '把短词延展后，5 字母词是很稳定的得分层。' },
  { lengthEn: '6 letters', lengthZh: '6 个字母', pointsEn: '3 points', pointsZh: '3 分', noteEn: 'Usually where strong scoring starts to separate players.', noteZh: '通常从这里开始，高手会和普通玩家拉开差距。' },
  { lengthEn: '7+ letters', lengthZh: '7 个以上字母', pointsEn: '5 points', pointsZh: '5 分', noteEn: 'High-value words that can swing a round quickly in this version of Boggle.', noteZh: '在这个版本里，高价值长词往往能迅速改变一局分差。' }
]
const boggleAnchorLinks = [
  { href: '#boggle-jump-links', labelEn: 'Quick links', labelZh: '快速跳转' },
  { href: '#boggle-rules-summary', labelEn: 'Rules summary', labelZh: '规则摘要' },
  { href: '#boggle-scoring-table', labelEn: 'Scoring table', labelZh: '计分表' },
  { href: '#guide-howtoplay-section', labelEn: 'How to play', labelZh: '玩法说明' },
  { href: '#boggle-rules-section', labelEn: 'Strategy notes', labelZh: '策略要点' },
  { href: '#guide-faq-section', labelEn: 'FAQ', labelZh: '常见问题' }
]
const boggleInternalLinks = [
  { href: '/guides/boggle/', labelEn: 'Boggle strategy guide', labelZh: 'Boggle 策略指南' },
  { href: '/hubs/word-games/', labelEn: 'More word games', labelZh: '更多文字游戏' },
  { href: '/games/word-search/', labelEn: 'Word Search', labelZh: '单词搜索' },
  { href: '/games/spelling-bee/', labelEn: 'Spelling Bee', labelZh: '拼字蜜蜂' }
]
const boggleRuleSetSchema = isBogglePage ? {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "Boggle Rules Summary",
  "description": "Core rules for playing classic 4x4 and big 5x5 Boggle online.",
  "url": `${canonicalUrl}#boggle-rules-summary`,
  "hasDefinedTerm": boggleRulesSummary.map((item) => ({
    "@type": "DefinedTerm",
      "name": item.ruleEn,
      "description": item.detailEn
  }))
} : undefined
const boggleScoringSchema = isBogglePage ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Boggle Scoring Table",
  "description": "Word length to score mapping for classic Boggle scoring.",
  "url": `${canonicalUrl}#boggle-scoring-table`,
  "numberOfItems": boggleScoringTable.length,
  "itemListElement": boggleScoringTable.map((row, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": `${row.lengthEn}: ${row.pointsEn}`,
    "description": row.noteEn
  }))
} : undefined
const bogglePageSchema = isBogglePage ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Play Boggle Online Free",
  "url": canonicalUrl,
  "description": seoDescription,
  "about": {
    "@type": "Thing",
    "name": "Boggle"
  },
  "keywords": ["boggle online free", "boggle game", "play boggle online", "boggle rules", "boggle scoring"],
  "hasPart": boggleAnchorLinks
    .filter((link) => link.href.startsWith('#'))
    .map((link) => ({
      "@type": "WebPageElement",
      "name": link.labelEn,
      "url": `${canonicalUrl}${link.href}`
    }))
} : undefined

// Generate FAQPage schema from in-page FAQ content for richer SERP coverage.
const faqSchema = gameGuideEn.faq && gameGuideEn.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": gameGuideEn.faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : undefined

// hreflang alternates. Ruleword uses ?lang= query params rather than separate URLs,
// so we declare both the canonical English page and the Chinese variant.
const hreflangUrls = [
  { lang: 'en', url: canonicalUrl },
  { lang: 'zh-CN', url: `${canonicalUrl}?lang=zh-CN` },
  { lang: 'x-default', url: canonicalUrl }
]
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={keywords}
  canonicalPath={`/games/${game.slug}/`}
  ogImage={`/og/game-${game.slug}.png`}
  gameType={gameType}
  breadcrumbItems={breadcrumbItems}
  howToSchema={howToSchema}
  aggregateRating={gameRating}
  hreflangUrls={hreflangUrls}
>
  <!-- Prefetch homepage for faster navigation -->
  <link rel="prefetch" href="/" />
  {bogglePageSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(bogglePageSchema)} />
  )}
  {boggleRuleSetSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(boggleRuleSetSchema)} />
  )}
  {boggleScoringSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(boggleScoringSchema)} />
  )}
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <div class="min-h-screen bg-slate-950 text-white flex flex-col">
    <!-- Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-slate-950/90 border-b border-slate-800 backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <!-- Left: Logo -->
          <div class="flex items-center gap-4">
            <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center text-white font-bold text-sm shadow-lg">
                R
              </div>
              <span class="font-semibold hidden sm:inline">Free Games Hub</span>
            </a>
          </div>

<!-- Center: Game Title (SEO optimized) -->
          <h1 class="text-lg font-bold truncate max-w-[200px] sm:max-w-none">
            <span class="hidden sm:inline">Play {getGameName()} Online Free</span>
            <span class="sm:hidden">{gameIcon} {getGameName()}</span>
          </h1>
          <span class="text-[11px] text-emerald-400/80 ml-2 shrink-0 hidden sm:inline">🔥 {gamePopularity.playCount}</span>

          <!-- Right: Favorite, Language and Feedback -->
          <div class="flex items-center gap-2">
            <FavoriteButton client:load gameSlug={game.slug} size="md" showLabel={false} />
            <div class="relative">
              <button id="lang-btn" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 transition-colors text-sm">
                <span class="text-lg">🌐</span>
                <span class="hidden sm:inline" id="current-lang">{languages.find(l => l.code === lang)?.nativeName || 'English'}</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="lang-dropdown" class="absolute right-0 mt-2 w-48 bg-slate-800 rounded-lg shadow-xl z-20 py-1 border border-slate-700 hidden">
                {languages.map(l => (
                  <button data-lang={l.code} class="w-full px-4 py-2 text-left text-sm hover:bg-slate-700 text-slate-300">
                    {l.nativeName}
                  </button>
                ))}
              </div>
            </div>
            <button
              id="feedback-btn"
              class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 transition-all text-sm font-medium"
            >
              <span>💬</span>
              <span class="hidden sm:inline">{t.nav.feedback}</span>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Game Area -->
    <main class="flex-1">
      {isExternalGame && externalGameData?.gameUrl ? (
        <!-- External Game iframe -->
        <div class="w-full h-full flex flex-col">
          <iframe
            src={externalGameData.gameUrl}
            width={externalGameData.iframeWidth || '100%'}
            height={externalGameData.iframeHeight || '600px'}
            allowfullscreen={externalGameData.allowFullscreen ?? true}
            class="flex-1 min-h-[600px] border-0"
            title={getGameName()}
            loading="lazy"
          ></iframe>
          {externalGameData.sourceName && (
            <div class="text-center py-2 text-sm text-slate-400 bg-slate-900/50">
              {t.game.source || 'Source'}: {externalGameData.sourceUrl ? (
                <a href={externalGameData.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
                  {externalGameData.sourceName}
                </a>
              ) : externalGameData.sourceName}
            </div>
          )}
        </div>
      ) : (
        <!-- Built-in Game -->
        <GameWrapper
          client:load
          gameId={gameId}
          gameName={getGameField('name', 'en') as string}
          gameSlug={gameSlug}
        />
      )}
    </main>

    {isBogglePage && (
      <section class="border-t border-slate-800 bg-gradient-to-b from-emerald-950/40 via-slate-950 to-slate-950 px-4 py-8 sm:px-6">
        <div class="mx-auto max-w-4xl">
          <div class="rounded-2xl border border-emerald-900/40 bg-slate-900/70 p-6 shadow-[0_0_0_1px_rgba(16,185,129,0.06)]">
            <p class="max-w-3xl text-base leading-7 text-slate-200 sm:text-lg">
              <span id="boggle-hero-copy"
                data-en="Play Boggle online free in your browser with no download or sign-up. Choose classic 4x4, big 5x5, relaxed practice, or the daily challenge, then review missed words after every round."
                data-zh="直接在浏览器里免费玩 Boggle，无需下载或注册。你可以选择经典 4x4、大型 5x5、放松练习或每日挑战，并在每局结束后复盘错过的单词。"
              >
              Play Boggle online free in your browser with no download or sign-up. Choose classic 4x4, big 5x5, relaxed practice, or the daily challenge, then review missed words after every round.
              </span>
            </p>

            <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {boggleQuickFacts.map((fact) => (
                <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-4">
                  <div class="text-xs uppercase tracking-[0.18em] text-emerald-400/80" data-fact-label-en={fact.labelEn} data-fact-label-zh={fact.labelZh}>{fact.labelEn}</div>
                  <div class="mt-2 text-sm font-medium text-white" data-fact-value-en={fact.valueEn} data-fact-value-zh={fact.valueZh}>{fact.valueEn}</div>
                </div>
              ))}
            </div>

            <nav id="boggle-jump-links" class="mt-6 rounded-xl border border-slate-800 bg-slate-950/60 p-4" aria-label="Boggle page quick links">
              <h2 id="boggle-jump-title" class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-400/80" data-en="Boggle Quick Links" data-zh="Boggle 快速跳转">Boggle Quick Links</h2>
              <p id="boggle-jump-desc" class="mt-2 text-sm leading-6 text-slate-400" data-en="Jump straight to Boggle rules, scoring, how to play, strategy notes, and FAQ sections." data-zh="直接跳到 Boggle 规则、计分、玩法说明、策略要点和常见问题。">
                Jump straight to Boggle rules, scoring, how to play, strategy notes, and FAQ sections.
