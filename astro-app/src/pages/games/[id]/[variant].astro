---
// Game Variant Page - Programmatic SEO for long-tail keywords
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getAllVariants, getVariant } from '../../../data/gameVariants'
import { getAllGames } from '../../../lib/games'

export function getStaticPaths() {
  const variants = getAllVariants()
  return variants.map(variant => ({
    params: { id: variant.gameId, variant: variant.variant },
  }))
}

const { id, variant: variantName } = Astro.params
if (!id || !variantName) {
  return Astro.redirect('/404')
}

const variant = getVariant(id, variantName)
const games = await getAllGames()
const game = games.find(g => g.id === id)

if (!variant || !game) {
  return Astro.redirect('/404')
}

// Get other variants for the same game
const allVariants = getAllVariants().filter(v => v.gameId === id)
const canonicalUrl = `https://ruleword.com/games/${game.id}/${variant.variant}/`
const baseGameUrl = `https://ruleword.com/games/${game.slug}/`
const variantLabel = variant.variant.charAt(0).toUpperCase() + variant.variant.slice(1)
const variantIntent = {
  difficulty: {
    label: 'Difficulty',
    summary: `${variantLabel} mode changes the challenge level so you can practice ${game.name} at the right pace.`,
    focus: 'Use this page when you want a targeted session instead of jumping straight into the default mode.',
  },
  size: {
    label: 'Board Size',
    summary: `${variantLabel} changes the board shape or puzzle scale, which affects pacing, planning, and recovery options.`,
    focus: 'Choose this version when you want a different puzzle rhythm from the standard board.',
  },
  mode: {
    label: 'Game Mode',
    summary: `${variantLabel} mode changes how the session is structured, giving the same core game a different goal.`,
    focus: 'Use this version when you want a more specific play loop than the regular game.',
  },
}[variant.variantType]
const relatedLinks = [
  { href: `/games/${game.id}/`, label: `Play ${game.name}`, description: 'Open the main game page with the full rule set and default experience.' },
  { href: `/guides/${game.slug}/`, label: `${game.name} Guide`, description: 'Read strategy notes, rules, and common mistakes before playing.' },
  { href: `/category/${game.category}/`, label: `More ${game.category} games`, description: 'Browse adjacent games in the same category.' },
]

// Schema for variant page
const schema = {
  "@context": "https://schema.org",
  "@type": ["Game", "WebApplication"],
  "name": variant.title,
  "description": variant.description,
  "alternateName": variant.h1,
  "genre": [game.category, "Puzzle"],
  "gamePlatform": "Web Browser",
  "applicationCategory": "GameApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript and a modern web browser",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "url": canonicalUrl,
  "isBasedOn": {
    "@type": "Game",
    "name": game.name,
    "url": baseGameUrl,
  },
  "keywords": variant.keywords,
  "numberOfPlayers": 1,
  "playMode": "SinglePlayer",
  "potentialAction": {
    "@type": "PlayAction",
    "target": `${baseGameUrl}?variant=${variant.variant}`,
  },
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://ruleword.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": game.name,
      "item": `https://ruleword.com/games/${game.id}/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": variantLabel,
      "item": canonicalUrl
    }
  ]
}

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Play ${variant.title}`,
  "step": variant.tips?.map((tip, index) => ({
    "@type": "HowToStep",
    "position": index + 1,
    "text": tip
  })) || []
}

const relatedLinksSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Related pages for ${variant.title}`,
  "itemListElement": relatedLinks.map((link, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": link.label,
    "url": `https://ruleword.com${link.href}`,
  }))
}
---

<BaseLayout
  title={variant.title}
  description={variant.description}
  keywords={variant.keywords}
  canonicalPath={`/games/${game.id}/${variant.variant}/`}
>
  <div class="min-h-screen bg-slate-950 text-white">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-slate-950/90 border-b border-slate-800 backdrop-blur-xl">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center text-white font-bold text-sm shadow-lg">
              R
            </div>
            <span class="font-semibold">Free Games Hub</span>
          </a>
          <nav class="flex items-center gap-4 text-sm">
            <a href={`/games/${game.id}/`} class="text-slate-400 hover:text-white transition-colors">
              {game.name}
            </a>
            <a href="/" class="text-slate-400 hover:text-white transition-colors">
              All Games
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(relatedLinksSchema)} />

    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm">
        <ol class="flex items-center gap-2 text-slate-400 flex-wrap">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li>/</li>
          <li><a href={`/games/${game.id}/`} class="hover:text-white transition-colors">{game.name}</a></li>
          <li>/</li>
          <li class="text-white capitalize">{variant.variant}</li>
        </ol>
      </nav>

      <!-- Hero -->
      <div class="flex items-start gap-4 mb-8">
        <div class="text-5xl">{game.icon}</div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold mb-2">
            {variant.h1}
          </h1>
          <p class="text-slate-300">
            {variant.description}
          </p>
        </div>
      </div>

      <!-- Game Embed -->
      <div class="bg-slate-900/50 border border-slate-800 rounded-2xl overflow-hidden mb-8">
        <div class="aspect-[4/3] sm:aspect-video flex items-center justify-center bg-slate-800">
          <div class="text-center p-8">
            <div class="text-6xl mb-4">{game.icon}</div>
            <h2 class="text-xl font-semibold mb-2">{game.name} - {variantLabel}</h2>
            <p class="text-slate-400 mb-4">Play the full game with {variant.variant} settings</p>
            <a
              href={`/games/${game.id}/?variant=${variant.variant}`}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 font-medium transition-all"
            >
              <span>▶️</span>
              Play Now
            </a>
          </div>
        </div>
      </div>

      <!-- Variant Tips -->
      {variant.tips && variant.tips.length > 0 && (
        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span>💡</span>
            Tips for {variantLabel} Mode
          </h2>
          <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-6">
            <ul class="space-y-3">
              {variant.tips.map((tip, index) => (
                <li class="flex items-start gap-3">
                  <span class="w-6 h-6 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center text-sm font-medium flex-shrink-0">
                    {index + 1}
                  </span>
                  <span class="text-slate-300">{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <section class="mb-8 grid gap-4 md:grid-cols-[1.1fr_0.9fr]">
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-green-400">{variantIntent.label}</p>
          <h2 class="mt-2 text-xl font-bold">Why Play {variant.h1}?</h2>
          <p class="mt-3 text-sm leading-6 text-slate-300">{variantIntent.summary}</p>
          <p class="mt-3 text-sm leading-6 text-slate-400">{variantIntent.focus}</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
          <h2 class="text-xl font-bold">Best For</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-300">
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-green-400"></span>
              Players searching for {variant.keywords[0] || variant.h1.toLowerCase()}.
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-green-400"></span>
              Short practice sessions before trying the full {game.name} experience.
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-green-400"></span>
              Comparing modes and choosing the right challenge level.
            </li>
          </ul>
        </div>
      </section>

      <!-- Other Variants -->
      {allVariants.length > 1 && (
        <section class="mb-8">
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
            <span>🎮</span>
            Other {game.name} Modes
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {allVariants.map(v => (
              <a
                href={`/games/${v.gameId}/${v.variant}/`}
                class={`group bg-slate-900/50 border rounded-xl p-4 hover:border-slate-500 transition-all text-center ${v.variant === variantName ? 'border-green-500' : 'border-slate-800'}`}
              >
                <div class="text-2xl mb-2">
                  {v.variantType === 'difficulty' && (v.variant === 'easy' ? '🟢' : v.variant === 'medium' ? '🟡' : '🔴')}
                  {v.variantType === 'size' && '📐'}
                  {v.variantType === 'mode' && '⚡'}
                </div>
                <h3 class="font-medium capitalize group-hover:text-green-400 transition-colors">
                  {v.variant}
                </h3>
                <p class="text-xs text-slate-500 mt-1 capitalize">{v.variantType}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Back to main game -->
      <section class="mb-8">
        <h2 class="mb-4 text-xl font-bold">Continue Exploring</h2>
        <div class="grid gap-3 md:grid-cols-3">
          {relatedLinks.map(link => (
            <a
              href={link.href}
              class="group rounded-xl border border-green-800/50 bg-gradient-to-br from-green-950/40 to-slate-900/70 p-5 transition-all hover:border-green-500"
            >
              <h3 class="font-semibold group-hover:text-green-400">{link.label}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-400">{link.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Related Games -->
      <section>
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <span>🎯</span>
          You Might Also Like
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {games
            .filter(g => g.category === game.category && g.id !== game.id)
            .slice(0, 4)
            .map(g => (
              <a
                href={`/games/${g.id}/`}
                class="group bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-slate-600 transition-all text-center"
              >
                <div class="text-3xl mb-2">{g.icon}</div>
                <h3 class="font-medium text-sm group-hover:text-green-400 transition-colors">
                  {g.name}
                </h3>
              </a>
            ))}
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-6 px-4 mt-8">
      <div class="max-w-4xl mx-auto text-center text-sm text-slate-400">
        <p>© 2026 Free Games Hub · Free Online Games</p>
      </div>
    </footer>
  </div>
</BaseLayout>
