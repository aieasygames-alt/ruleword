{
  "name": "ruleword-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "node cms-proxy.js & astro dev",
    "prebuild": "npx tsx scripts/generate-images.ts",
    "build": "npx tsx scripts/generate-images.ts && astro build",
    "preview": "astro preview",
    "cms:migrate": "npx tsx scripts/migrate-to-contentful.ts",
    "cms:migrate:sanity": "npx tsx scripts/migrate-to-sanity.ts",
    "cms:sync": "npx tsx scripts/sync-from-contentful.ts",
    "sanity:dev": "cd sanity && sanity dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "audit:games": "tsx scripts/audit-game-catalog.mts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "ws": "^8.21.0"
    }
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@sanity/client": "^8.8.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.3.5",
    "contentful": "^11.12.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.27",
    "contentful-management": "^11.74.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
